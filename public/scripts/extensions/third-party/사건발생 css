        <svg viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.03 2 11c0 2.7 1.22 5.12 3.18 6.83L4 22l4.55-1.84C9.61 20.68 10.78 21 12 21c5.52 0 10-4.03 10-9s-4.48-9-10-9z"/>
        </svg>
      </div>
      <div class="notif-app-name">Messages</div>
      <div class="notif-time">지금</div>
    </div>
    <div class="notif-body">
      <div class="notif-sender">(사건발생제목)</div>
      <div class="notif-text">(사건발생내용)</div>
    </div>
  </div>
</div>

</body>
</html>
